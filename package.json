{
  "name": "pumpworks-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @pumpworks/client --filter @pumpworks/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test:browser": "playwright test",
    "test:movement": "pnpm --filter @pumpworks/shared test:movement"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "typescript-eslint": "8.46.2",
    "typescript": "5.9.3",
    "@playwright/test": "1.56.1"
  }
}
